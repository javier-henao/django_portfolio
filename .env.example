# Variables de entorno (copia a .env para desarrollo local)
# En Railway configúralas en: Service -> Variables

# Obligatorio en producción: clave larga y aleatoria.
# Genera una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Nunca dejes DEBUG=True en producción.
DEBUG=False

# Railway inyecta DATABASE_URL al conectar el plugin de PostgreSQL.
# No es necesario definirla a mano.
# DATABASE_URL=postgresql://usuario:password@host:puerto/base

# Usuario que crea start.sh en cada arranque (solo si no existe).
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=cambia-esta-clave
# DJANGO_SUPERUSER_EMAIL=tu@correo.com

# Opcionales (separados por comas). Los valores de Railway se detectan solos.
# ALLOWED_HOSTS=midominio.com,www.midominio.com
# CSRF_TRUSTED_ORIGINS=https://midominio.com
